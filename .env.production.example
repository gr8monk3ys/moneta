# Moneta production environment template
# Copy to your secret manager or deployment platform configuration.
# Do not commit real production secrets.

# Core runtime
NODE_ENV=production
DATABASE_URL=postgres://moneta_user:replace-me@db.example.com:5432/moneta
TRUST_PROXY=true
CORS_ORIGINS=https://app.example.com,https://www.example.com

# Auth and observability secrets
JWT_SECRET=replace-with-32-plus-char-production-secret
JWT_REFRESH_SECRET=replace-with-different-32-plus-char-production-secret
METRICS_TOKEN=replace-with-24-plus-char-metrics-token

# Email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Moneta <support@example.com>

# Billing and purchase verification
BILLING_WEBHOOK_SECRET=replace-with-24-plus-char-billing-webhook-secret
BILLING_ALLOW_SANDBOX_PURCHASES=false

# iOS billing
APPLE_SHARED_SECRET=replace-with-apple-shared-secret

# Android billing
GOOGLE_PLAY_PACKAGE_NAME=com.moneta.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me","private_key_id":"replace-me","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n","client_email":"replace-me@replace-me.iam.gserviceaccount.com","client_id":"replace-me"}

# Mobile release values also consumed by billing-release checks
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_IOS_SUBSCRIPTION_PRODUCT_IDS=moneta.pro.monthly,moneta.pro.yearly
EXPO_PUBLIC_ANDROID_SUBSCRIPTION_PRODUCT_IDS=moneta.pro.monthly,moneta.pro.yearly
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://www.example.com/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://www.example.com/terms
EXPO_PUBLIC_SUBSCRIPTION_TERMS_URL=https://www.example.com/subscription-terms
EXPO_PUBLIC_FINANCIAL_DISCLAIMER_URL=https://www.example.com/financial-disclaimer
EXPO_PUBLIC_ACCOUNT_DELETION_POLICY_URL=https://www.example.com/account-deletion
EXPO_PUBLIC_BILLING_SANDBOX_MODE=false
