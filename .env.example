PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800
REFRESH_TOKEN_PRUNE_INTERVAL_SECONDS=300
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moneta
METRICS_TOKEN=replace-with-strong-token
RATE_LIMIT_REDIS_URL=redis://localhost:6379
TRUST_PROXY=false

# Email (password reset)
# In production these must be set so the API can email reset codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@moneta.example
