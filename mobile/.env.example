# Every variable the Moneta mobile app reads. Copy to `mobile/.env`.
#
# Expo bundles ONLY names starting with EXPO_PUBLIC_, and it bakes in the value
# present when the bundle is built — changing a value means rebuilding (and
# clearing Metro's cache with `--clear`, which caches the inlined values).
# Treat everything here as public: it ships inside the client bundle.

# Backend API base URL for Expo app
# Simulator: http://localhost:3000
# Physical device: http://<YOUR_LAN_IP>:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional billing sandbox toggle
EXPO_PUBLIC_BILLING_SANDBOX_MODE=true

# Optional (needed for real store billing; sandbox mode works without these)
EXPO_PUBLIC_IOS_SUBSCRIPTION_PRODUCT_IDS=moneta.pro.monthly,moneta.pro.yearly
EXPO_PUBLIC_ANDROID_SUBSCRIPTION_PRODUCT_IDS=moneta.pro.monthly,moneta.pro.yearly

# Legal/policy URLs (required for preview/production builds)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://example.com/terms
EXPO_PUBLIC_SUBSCRIPTION_TERMS_URL=https://example.com/subscription-terms
EXPO_PUBLIC_FINANCIAL_DISCLAIMER_URL=https://example.com/financial-disclaimer
EXPO_PUBLIC_ACCOUNT_DELETION_POLICY_URL=https://example.com/account-deletion
