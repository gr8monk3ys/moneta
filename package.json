{
  "name": "moneta",
  "version": "1.1.0",
  "description": "An iOS / Android application for learning finance.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "lint": "eslint .",
    "depcruise": "depcruise src api tests --config .dependency-cruiser.cjs",
    "test": "vitest run --exclude dist tests",
    "test:integration": "vitest run --exclude dist tests/postgres.integration.test.ts --reporter=default --reporter=json --outputFile.json=reports/integration.json",
    "test:all": "npm test && npm run test:integration",
    "test:coverage": "vitest run --coverage --exclude dist tests",
    "check:docs": "./scripts/docs-readiness-check.sh",
    "check:billing-release": "./scripts/billing-release-readiness-check.sh",
    "check:launch-docs": "./scripts/launch-doc-readiness-check.sh",
    "release:evidence": "./scripts/collect-release-evidence.sh",
    "test:ci": "vitest run --coverage --exclude dist tests --reporter=default --reporter=json --outputFile.json=reports/unit.json",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs --reporter=default --reporter=json --outputFile.json=reports/e2e.json",
    "test:browser": "playwright test",
    "check:synthetic-uptime": "./scripts/synthetic-uptime-check.sh",
    "verify": "./scripts/final-verification-gate.sh",
    "verify:backend": "npm run lint && npm run depcruise && npm run test:ci && npm run test:integration && npm run build && npm run test:e2e && npm run test:browser && npm audit --audit-level=high",
    "verify:mobile": "mkdir -p reports && cd mobile && npm run lint && npm run typecheck && npm run test:ci -- --json --outputFile=../reports/mobile.json && node scripts/audit-gate.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.10",
    "nodemailer": "^10.0.9",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "qs": "6.17.1",
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^9.39.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
